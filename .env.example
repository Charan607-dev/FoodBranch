# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Optional. If configured, FoodBridge connects directly to your live Supabase database.
# Otherwise, FoodBridge seamlessly runs on the built-in persistent local database engine.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION (Render / External PostgreSQL)
# ==============================================================================
# DATABASE_URL: The connection string provided by Render PostgreSQL.
# Example format: postgresql://foodbridge_user:your_password@dpg-xxxx-a.oregon-postgres.render.com/foodbridge_db?sslmode=require
# FoodBridge reads this exclusively on the server side via process.env.DATABASE_URL.
DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# JWT_SECRET: Secret key for signing role-based session tokens.
JWT_SECRET="your-secure-jwt-secret-key-here"

# PORT: Server listening port (defaults to 3000 in development)
PORT="3000"
